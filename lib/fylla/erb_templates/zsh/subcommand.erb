function _<%= @executable_name %><%= context_name %> {
  local line
  <%- unless command.commands.empty? %>
  local -a commands
  commands=(
  <%-# remove newlines and leading space on this loop -%>
  <%- command.commands.sort_by(&:name).each do |command| -%>
    '<%= command.name %>:<%= Fylla::ShellEscape.zsh_single_quoted(command.description) %>'
  <%- end -%>
  )
  <%- end %>
  _arguments \
  <%- unless class_options.nil? -%>
    <%- class_options.each do |option| -%>
      <%- desc = Fylla::ShellEscape.zsh_optspec(option.description) -%>
    "--<%= option.name %><%= option.equals_type %>[<%= desc %>]<%= option.action %>" \
      <%- option.aliases.each do |al| -%>
    "<%= al %><%= option.equals_type %>[<%= desc %>]<%= option.action %>" \
      <%- end -%>
    <%- end -%>
  <%- end -%>
    "-h[Show help information]" \
    "--help[Show help information]" \
    "1: : _describe 'command' commands" \
    "*::arg:->args"

  case $state in
    args)
      case $line[1] in
      <%- command.commands.sort_by(&:name).each do |command| -%>
        <%= command.name %>)
          _<%= @executable_name %><%= context_name %>_<%= command.name %>
        ;;
      <%- end -%>
      esac
    ;;
  esac
}
